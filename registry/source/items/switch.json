      "contentType": "text/css",
      "sourceFile": "css/switch.css"
    }
  ],
  "minimumBenosVersions": [
    {
      "name": "@benosjs/core",
      "version": "0.2.0"
    },
    {
      "name": "@benosjs/dom",
      "version": "0.2.0"
    },
    {
      "name": "@benosjs/primitives",
      "version": "0.2.0"
    }
  ]
