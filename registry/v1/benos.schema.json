{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/benosjs/benos/main/registry/v1/benos.schema.json",
  "title": "Benos UI project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "registry",
    "style",
    "components",
    "css",
    "alias"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 1 },
    "registry": { "type": "string", "format": "uri" },
    "style": { "type": "string", "minLength": 1 },
    "components": { "type": "string", "minLength": 1 },
    "css": { "type": "string", "minLength": 1 },
    "alias": { "const": "@/" }
  }
}
