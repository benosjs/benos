{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/benosjs/benos/main/registry/v1/item.schema.json",
  "title": "Benos UI registry item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "name",
    "type",
    "title",
    "description",
    "dependencies",
    "registryDependencies",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "enum": ["registry:component", "registry:style"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/dependency" }
    },
    "registryDependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "target", "contentType", "content", "checksum"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
          },
          "target": {
            "type": "string",
            "pattern": "^(?:components|css)/[^\\\\\\u0000]+$"
          },
          "contentType": {
            "enum": [
              "text/css",
              "text/html",
              "text/javascript",
              "text/tsx",
              "text/typescript"
            ]
          },
          "content": { "type": "string" },
          "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}
