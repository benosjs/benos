{
  "name": "benos-monorepo",
  "version": "0.1.2",
  "description": "A TypeScript-first fine-grained frontend framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/benosjs/benos.git"
  },
  "license": "MIT",
  "keywords": [
    "benos",
    "frontend",
    "fine-grained",
    "signals",
    "typescript"
  ],
  "homepage": "https://github.com/benosjs/benos#readme",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build.mjs",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "bench:kernel": "node benchmarks/kernel.mjs",
    "bench:compare": "node benchmarks/compare-kernel.mjs",
    "bench:guard": "node benchmarks/guard-kernel.mjs",
    "bench:jfb": "pnpm --dir benchmarks/js-framework-benchmark install --frozen-lockfile --ignore-workspace && pnpm --dir benchmarks/js-framework-benchmark bench",
    "bench:profile": "node --expose-gc benchmarks/kernel-profile.mjs",
    "lint": "eslint . && prettier --check .",
    "typecheck:types": "tsc -p tests/tsconfig.types.json --noEmit",
    "check:public-imports": "node scripts/check-public-imports.mjs",
    "check:packed": "node scripts/check-packed-metadata.mjs",
    "check:engines": "node scripts/check-engines.mjs",
    "audit:template": "node scripts/audit-template.mjs",
    "registry:build": "node scripts/build-ui-registry.mjs",
    "registry:check": "node scripts/build-ui-registry.mjs --check",
    "gallery": "pnpm --filter @benosjs/ui-gallery dev",
    "gallery:build": "pnpm --filter @benosjs/ui-gallery build",
    "test:ui-cli:matrix": "node scripts/test-ui-cli-project.mjs",
    "check:jsx-types": "node scripts/generate-jsx-types.mjs --check",
    "check:doc-examples": "node scripts/check-doc-examples.mjs",
    "size": "node scripts/check-size.mjs",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.6",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@benosjs/dom": "workspace:*",
    "@benosjs/primitives": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.55.0",
    "@preact/signals-core": "^1.14.4",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "@webref/elements": "2.9.0",
    "@webref/idl": "3.85.0",
    "@zag-js/select": "1.44.0",
    "alien-signals": "^3.2.1",
    "aria-query": "5.3.2",
    "axe-core": "4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "expect-type": "^1.4.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.2",
    "semver": "^7.8.5",
    "solid-js": "^1.9.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "bugs": {
    "url": "https://github.com/benosjs/benos/issues"
  }
}
