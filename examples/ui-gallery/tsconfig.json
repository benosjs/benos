{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@benosjs/dom",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@benosjs/core": ["../../packages/core/dist/types/index.d.ts"],
      "@zag-js/toast": [
        "../../packages/primitives/node_modules/@zag-js/toast/dist/index.d.mts"
      ],
      "@zag-js/vanilla": [
        "../../packages/primitives/node_modules/@zag-js/vanilla/dist/index.d.mts"
      ]
    }
  },
  "include": ["src", "vite.config.ts"]
}
